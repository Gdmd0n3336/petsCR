{
  "permissions": {
    "deny": [
      "Bash(*impeccable/scripts/impeccable*)",
      "Bash(*.impeccable/bin/*)",
      "Bash(impeccable)",
      "Bash(impeccable *)",
      "Bash(*IMPECCABLE_BIN*)",
      "Bash(*impeccable* hooks on*)",
      "Bash(*impeccable* live*)",
      "Bash(*impeccable* generate-image*)",
      "Skill(impeccable hooks on*)",
      "Skill(impeccable live*)",
      "Skill(impeccable generate*)",
      "Write(/DESIGN.md)",
      "Edit(/DESIGN.md)",
      "Write(/PRODUCT.md)",
      "Edit(/PRODUCT.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-bash.sh" }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-hardcoded-secrets.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-anti-excuses.sh" }
        ]
      }
    ]
  }
}
