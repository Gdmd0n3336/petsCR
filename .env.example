# Скопируйте в .env.local и заполните значениями из панели Supabase (Project Settings → API).
# В браузер попадают только переменные с префиксом VITE_. Ключ service_role сюда не класть.
# Если обе переменные Supabase пусты, приложение работает в тестовом режиме на fixtures/catalog.sample.json.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Ключ Maps JavaScript API. Он виден в браузере: в Google Cloud ограничьте его по доменам,
# по API (только Maps JavaScript API) и дневной квотой. Пусто — вместо карты заглушка.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID из Google Cloud → Map Management (нужен для AdvancedMarkerElement).
# Пусто — DEMO_MAP_ID, который Google разрешает только для разработки.
VITE_GOOGLE_MAPS_MAP_ID=

# Базовый адрес приложения для ссылок «Поделиться» (например https://lapa.example).
# Пусто — текущий адрес страницы.
VITE_PUBLIC_BASE_URL=
